NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where order notifications are sent. Without it an order still lands in the
# admin panel; only the email is skipped.
ORDER_NOTIFICATION_TO=

# Email transport. Both are needed before anything is sent, and the from address
# must sit on a domain verified with the provider.
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM=

# Cloudflare Turnstile no login do admin. Sem as duas, o login funciona igual e
# a verificação é pulada; com as duas, o widget aparece e o servidor valida o
# token antes de checar a senha. Crie um site em dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
